# Copy to .env for live mode (never commit .env)
GEMINI_API_KEY=your_gemini_api_key_here
DROPSHIELDER_LIVE=all
DROPSHIELDER_PACKAGE_JSON=storefront/package.json
DROPSHIELDER_STOREFRONT_DIR=storefront
SHOPIFY_STORE_DOMAIN=www.pipsticks.com
# Optional if using a custom headless Shopify Storefront token:
SHOPIFY_STOREFRONT_TOKEN=
